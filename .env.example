# ===== Projeto Ametista - configurações =====

AMETISTA_NOME=Ametista
AMETISTA_DONO=Gabriel

# --- Cérebro na nuvem (Claude) - crie a chave em https://console.anthropic.com
ANTHROPIC_API_KEY=
# haiku = rápido e barato (bom para voz); um modelo Sonnet responde melhor, mas custa mais
CLAUDE_MODELO=claude-haiku-4-5

# --- Spotify Premium - veja o passo a passo no LEIA-ME
SPOTIFY_CLIENT_ID=

# --- Atalho para chamar sem falar
ATALHO=ctrl+shift+space

# --- Ouvido (tudo offline, no seu PC)
OUVIDO_LIGADO=1
# tiny/base = mais rápido e menos preciso; small = equilíbrio; medium = mais preciso (precisa de PC forte)
WHISPER_MODELO=small
# cuda se tiver placa NVIDIA com CUDA instalado (fica bem mais rápido)
WHISPER_DISPOSITIVO=cpu
# vazio = microfone padrão do Windows. Para escolher outro, coloque o número dele
MICROFONE=
# sensibilidade: diminua se ela não perceber sua voz; aumente se o ambiente for barulhento
LIMIAR_MIN=350
# segundos ouvindo depois de responder, sem precisar dizer o nome
TEMPO_SEGUIMENTO=6

# --- Voz da Ametista
# edge = vozes prontas grátis | elevenlabs = voz clonada (nuvem) | local = voz clonada no PC
# (o clonar_voz.bat preenche isso sozinho)
VOZ_PROVEDOR=edge
AMETISTA_VOZ=pt-BR-FranciscaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOZ_ID=
ELEVENLABS_MODELO=eleven_flash_v2_5

# --- Quem pode falar com ela
# restrito = só vozes cadastradas | misto = desconhecidos viram visitantes | aberto = qualquer um
# (enquanto ninguém estiver cadastrado, ela atende qualquer voz)
MODO_VOZ=restrito
# 0.55 = mais tolerante ... 0.70 = mais exigente
LIMIAR_VOZ=0.62

# --- Celular (o publicar_celular.bat preenche isso sozinho)
NUVEM_URL=
NUVEM_CHAVE=
NUVEM_MOSTRAR_JANELA=1

# --- Agenda
MS_CLIENT_ID=
AGENDA_PADRAO=google
AVISO_AGENDA_MIN=10

# --- Steam (vazio = acha sozinha)
STEAM_PASTA=

# --- Cérebro local (opcional) - instale o Ollama e rode: ollama pull qwen2.5:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:3b

# --- Clima
CIDADE=São Paulo
LATITUDE=-23.55
LONGITUDE=-46.63

# --- Notícias (qualquer feed RSS)
NOTICIAS_RSS=https://g1.globo.com/rss/g1/

# --- Casa inteligente (Home Assistant) - veja o LEIA-ME
HA_URL=
HA_TOKEN=

# Porta interna (se mudar, atualize também o Redirect URI no painel do Spotify)
PORTA=8765
