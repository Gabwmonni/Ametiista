# ===== Projeto Ametista - configurações =====
# Quase tudo aqui também muda pelo painel: botão direito no ícone da Ametista > Configurações.
# Linhas começando com # são comentários. Chave vazia = usa o padrão.

# --- Geral
# Nome da assistente. A palavra de ativação continua sendo "Ametista".
AMETISTA_NOME=Ametista
# Seu nome.
AMETISTA_DONO=Gabriel
# Cidade (clima e notícias).
CIDADE=São Paulo
# Latitude.
LATITUDE=-23.55
# Longitude.
LONGITUDE=-46.63
# Atalho para chamar.
ATALHO=ctrl+shift+space
# Atalho de emergência (parar tudo). Cala a Ametista, cancela o que ela estiver fazendo e pausa a música.
ATALHO_PARAR=ctrl+shift+backspace
# Feed de notícias (RSS).
NOTICIAS_RSS=https://g1.globo.com/rss/g1/

# --- Cérebro
# Chave da API da Anthropic. Crie em console.anthropic.com.
ANTHROPIC_API_KEY=
# Modelo do dia a dia. Usado na maioria dos pedidos. Tem que ser rápido para a voz.
#   claude-haiku-4-5 = Claude Haiku 4.5 (rápido e barato, o melhor para voz)
#   claude-sonnet-5 = Claude Sonnet 5 (mais esperto, um pouco mais lento)
CLAUDE_MODELO=claude-haiku-4-5
# Modelo para pedidos difíceis. Entra em explicações, análises, a tela e o modo agente.
#   claude-opus-5 = Claude Opus 5 (recomendado)
#   claude-sonnet-5 = Claude Sonnet 5 (mais barato)
#   claude-fable-5-1 = Claude Fable 5.1 (o mais capaz, o mais caro)
CLAUDE_MODELO_FORTE=claude-opus-5
# Escolher o modelo pela dificuldade. Desligado: usa sempre o modelo do dia a dia.
#   1 = sim, 0 = não
MODELO_AUTOMATICO=1
# Modelo do modo agente. Faz tarefas grandes e controla o mouse e o teclado.
#   claude-opus-5 = Claude Opus 5 (recomendado)
#   claude-sonnet-5 = Claude Sonnet 5 (mais barato)
#   claude-fable-5-1 = Claude Fable 5.1 (o mais capaz, o mais caro)
AGENTE_MODELO=claude-opus-5
# Endereço do Ollama (IA local de reserva).
OLLAMA_URL=http://localhost:11434
# Modelo do Ollama.
OLLAMA_MODELO=qwen2.5:3b

# --- Voz
# Voz da Ametista.
#   edge = Vozes prontas da Microsoft (grátis)
#   elevenlabs = Voz clonada na ElevenLabs
#   local = Voz clonada no próprio PC (XTTS)
VOZ_PROVEDOR=edge
# Voz pronta. Francisca: leve e clara (recomendada). Thalita: mais grave e muito natural; combine com um tom mais leve. Toque em Ouvir para comparar antes de salvar.
AMETISTA_VOZ=pt-BR-FranciscaNeural
# Velocidade da voz pronta.
#   -10% = Bem devagar
#   -4% = Calma e atenciosa (recomendada)
#   +0% = Normal
#   +5% = Um pouco rápida
#   +15% = Rápida
VOZ_VELOCIDADE=-4%
# Tom da voz pronta. Mais leve = um pouco mais fina, sem ficar infantil.
#   -6Hz = Mais grave
#   +0Hz = O natural da voz
#   +4Hz = Um pouco mais leve
#   +8Hz = Leve e acolhedora (recomendado)
#   +12Hz = Mais leve
#   +16Hz = Bem leve
VOZ_TOM=+8Hz
# Chave da ElevenLabs.
ELEVENLABS_API_KEY=
# ID da voz na ElevenLabs. O clonar_voz.bat preenche sozinho.
ELEVENLABS_VOZ_ID=
# Modelo da ElevenLabs.
#   eleven_flash_v2_5 = Flash v2.5 (a mais rápida)
#   eleven_multilingual_v2 = Multilingual v2 (mais natural)
#   eleven_v3 = v3 (a mais expressiva: risadas, suspiros, pausas)
ELEVENLABS_MODELO=eleven_flash_v2_5
# Risadas, suspiros e pausas. Só funciona com a ElevenLabs v3. Nas outras vozes as marcas são removidas.
#   1 = sim, 0 = não
VOZ_EXPRESSIVA=1

# --- Ouvido
# Usar o microfone.
#   1 = sim, 0 = não
OUVIDO_LIGADO=1
# Microfone. Vazio = o microfone padrão do Windows.
MICROFONE=
# Sensibilidade. Menor = percebe voz mais baixa. Maior = ignora mais barulho (200 a 600).
LIMIAR_MIN=350
# Precisão da transcrição.
#   base = Rápida
#   small = Equilibrada
#   medium = Precisa (precisa de PC forte)
WHISPER_MODELO=small
# Transcrever com.
#   cpu = Processador
#   cuda = Placa NVIDIA (CUDA)
WHISPER_DISPOSITIVO=cpu
# Segundos ouvindo depois de responder. Nesse tempo você fala sem repetir o nome.
TEMPO_SEGUIMENTO=8
# Minutos de conversa contínua. Depois disso ela continua atenta, mas só responde o que for claramente para ela. 0 desliga.
CONVERSA_MINUTOS=3
# Interromper a fala dela pela voz. Diga "Ametista" ou "para" enquanto ela fala.
#   1 = sim, 0 = não
INTERROMPER_POR_VOZ=1

# --- Pessoas
# Quem pode falar com ela.
#   restrito = Só vozes cadastradas
#   misto = Desconhecidos viram visitantes
#   aberto = Qualquer pessoa
MODO_VOZ=restrito
# Rigor no reconhecimento de voz. 0.55 = mais tolerante, 0.70 = mais exigente.
LIMIAR_VOZ=0.62

# --- Proatividade
# Iniciativa da Ametista.
#   0 = Desligada: só fala quando chamada
#   1 = Só o importante (bateria, disco, chuva)
#   2 = Normal (inclui pausas e resumo do dia)
PROATIVIDADE=2
# No máximo quantos avisos por hora.
PROATIVO_MAX_HORA=3
# Minutos mínimos entre dois avisos.
PROATIVO_INTERVALO_MIN=20
# Horário de silêncio. Nesse horário ela não puxa assunto. Alarmes e lembretes pedidos por você tocam normalmente.
HORARIO_SILENCIO=22:00-07:00
# Resumo do dia ao ligar o PC.
#   1 = sim, 0 = não
RESUMO_DIARIO=1
# Sugerir pausa depois de quantos minutos no PC. 0 desliga.
PAUSA_MINUTOS=120

# --- Memória
# Guardar o histórico das conversas. Permite perguntar "o que eu te pedi ontem?".
#   1 = sim, 0 = não
GUARDAR_CONVERSAS=1
# Guardar conversas por quantos dias. 0 = para sempre.
DIAS_CONVERSAS=365
# Busca por significado. Acha lembranças mesmo com outras palavras. Roda no PC (baixa uns 220 MB na primeira vez).
#   1 = sim, 0 = não
BUSCA_SEMANTICA=1
# Pastas extras para ela achar arquivos. Separe por ponto e vírgula. Área de Trabalho, Documentos e Downloads já entram.
PASTAS_INDICE=

# --- Agenda
# Agenda padrão.
#   google = Google Agenda
#   outlook = Outlook
AGENDA_PADRAO=google
# Avisar quantos minutos antes. 0 desliga.
AVISO_AGENDA_MIN=10
# Hora do aviso de aniversário.
ANIVERSARIO_HORA=09:00
# Avisar também na véspera.
#   1 = sim, 0 = não
ANIVERSARIO_VESPERA=1
# ID do app do Outlook (Azure).
MS_CLIENT_ID=

# --- Contas
# Client ID do Spotify.
SPOTIFY_CLIENT_ID=
# Pasta da Steam. Vazio = acha sozinha.
STEAM_PASTA=

# --- Casa
# Endereço do Home Assistant. Ex.: http://192.168.0.10:8123
HA_URL=
# Token do Home Assistant.
HA_TOKEN=
# Você no Home Assistant. Ex.: person.gabriel. Serve para lembretes "quando eu chegar em casa".
HA_PESSOA=

# --- Celular
# Endereço do app do celular. O publicar_celular.bat preenche sozinho.
NUVEM_URL=
# Chave secreta do PC.
NUVEM_CHAVE=
# Mostrar no celular a janela aberta no PC.
#   1 = sim, 0 = não
NUVEM_MOSTRAR_JANELA=1

# --- Avançado
# Porta interna. Se mudar, atualize também o Redirect URI no painel do Spotify.
PORTA=8765
